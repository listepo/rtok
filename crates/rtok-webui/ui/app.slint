import { Button, CheckBox, ListView, LineEdit, Palette } from "std-widgets.slint";

import { RtokTheme } from "theme.slint";
import { BodyText, Card, IconSlot, ListRow, MetaText, NavItem, PageScroll, Panel, PanelNote, PanelTitle, RowText, SectionText, TitleText } from "kit.slint";

// Bundled IBM Plex Mono (OFL) — weights 400 / 600 / 700
import "./fonts/IBMPlexMono-Regular.ttf";
import "./fonts/IBMPlexMono-SemiBold.ttf";
import "./fonts/IBMPlexMono-Bold.ttf";

export struct PageTab {
    id: string,
    title: string,
}

export struct PluginRow {
    id: string,
    title: string,
    summary: string,
    fields: string,
    enabled: bool,
    saves-tokens: bool,
    input-tokens: int,
    output-tokens: int,
    cache-read: int,
    cache-create: int,
    est-before: int,
    est-after: int,
    rows: int,
}

export struct CallRow {
    when: string,
    surface: string,
    kind: string,
    name: string,
    session: string,
    ms: string,
    tokens: string,
    subtitle: string,
    detail: string,
    ref-id: string,
}

export struct SkillRow {
    name: string,
    source: string,
    desc-chars: string,
    body-bytes: string,
    invocations: string,
    resident: string,
    last-invoked: string,
    never: bool,
    summary: string,
}

export struct SessionRow {
    id: string,
    host: string,
    provider: string,
    model: string,
    input: int,
    output: int,
    cache-create: int,
    cache-read: int,
    live: bool,
    status: string,
    activity: string,
    summary: string,
    detail: string,
}

struct Metric {
    label: string,
    value: string,
    accent: bool,
}

/// Shared stats grid for plugins that record Measurement / usage rows.
/// Cells sit on one column grid, so labels and values line up across rows:
/// one row when every cell gets ≥ 120px, else 3 (or 2) columns.
export component TokenStatsWidget inherits Card {
    in property <int> input-tokens;
    in property <int> output-tokens;
    in property <int> cache-read;
    in property <int> cache-create;
    in property <int> est-before;
    in property <int> est-after;
    in property <int> rows;
    /// The overview has no estimates — it shows the four usage cells only.
    in property <bool> show-estimates: true;
    property <[Metric]> all-metrics: [
        { label: "input", value: "\{input-tokens}", accent: false },
        { label: "output", value: "\{output-tokens}", accent: false },
        { label: "cache read", value: "\{cache-read}", accent: false },
        { label: "cache create", value: "\{cache-create}", accent: false },
        { label: "est before → after", value: "\{est-before} → \{est-after}", accent: true },
        { label: "rows", value: "\{rows}", accent: false },
    ];
    property <[Metric]> usage-metrics: [
        { label: "input", value: "\{input-tokens}", accent: false },
        { label: "output", value: "\{output-tokens}", accent: false },
        { label: "cache read", value: "\{cache-read}", accent: false },
        { label: "cache create", value: "\{cache-create}", accent: false },
    ];
    property <[Metric]> metrics: show-estimates ? all-metrics : usage-metrics;
    // Tracked, not bound: a live `root.width` read here would loop through
    // the parent layout's layoutinfo.
    property <length> strip-w: 800px;
    changed width => { strip-w = root.width; }
    init => { strip-w = root.width; }
    property <int> count: metrics.length;
    property <int> cols: strip-w >= count * 120px
        ? count
        : (strip-w >= 360px && Math.mod(count, 3) == 0 ? 3 : 2);
    property <int> row-count: Math.ceil(count / cols);
    property <length> pad: RtokTheme.space-3;
    property <length> gap: RtokTheme.space-3;
    property <length> cell-h: 44px;
    property <length> cell-w: (strip-w - 2 * pad - (cols - 1) * gap) / cols;
    property <length> value-size: cell-w >= 170px ? 18px : 14px;
    property <length> strip-h: 2 * pad + row-count * cell-h + (row-count - 1) * gap;
    border-radius: RtokTheme.radius-md;
    min-height: strip-h;
    preferred-height: strip-h;
    max-height: strip-h;
    for m[i] in metrics: VerticalLayout {
        x: pad + Math.mod(i, cols) * (cell-w + gap);
        y: pad + Math.floor(i / cols) * (cell-h + gap);
        width: cell-w;
        height: cell-h;
        spacing: RtokTheme.space-1;
        MetaText {
            text: m.label;
            height: 16px;
            vertical-alignment: center;
            overflow: elide;
        }
        Text {
            text: m.value;
            height: 24px;
            color: m.accent ? RtokTheme.accent : RtokTheme.ink;
            font-size: value-size;
            font-weight: 600;
            vertical-alignment: center;
            overflow: elide;
        }
    }
}

/// Same toggle as the TUI Plugins tab (T60.5): click sends `plugins.<id>.enabled`.
/// Inherits the std `CheckBox` — focus, hover and accessibility come from the widget.
component PluginEnableToggle inherits CheckBox {
    in property <bool> on;
    in property <string> plugin-id;
    callback enable(bool);
    accessible-label: "toggle " + plugin-id;
    text: "enabled";
    checked: root.on;
    toggled() => { root.enable(self.checked); }
}

component PluginList inherits Panel {
    in property <[PluginRow]> plugins;
    in-out property <int> cursor;
    PanelTitle {
        text: "plugins";
    }
    ListView {
        for p[i] in root.plugins: ListRow {
            selected: i == root.cursor;
            label: p.title;
            activated => { root.cursor = i; }
            RowText {
                text: p.title;
                selected: i == root.cursor;
                color: i == root.cursor ? RtokTheme.accent : (p.enabled ? RtokTheme.ink : RtokTheme.ink-subtle);
            }
        }
    }
}

component PluginDetail inherits PageScroll {
    in property <PluginRow> plugin;
    callback toggle-plugin(string, bool);
    TitleText {
        text: plugin.title;
    }
    PluginEnableToggle {
        on: plugin.enabled;
        plugin-id: plugin.id;
        enable(value) => { root.toggle-plugin(plugin.id, value); }
    }
    BodyText {
        text: plugin.summary;
    }
    if plugin.fields != "": BodyText {
        text: plugin.fields;
        color: RtokTheme.ink-subtle;
    }
    if plugin.saves-tokens: TokenStatsWidget {
        input-tokens: plugin.input-tokens;
        output-tokens: plugin.output-tokens;
        cache-read: plugin.cache-read;
        cache-create: plugin.cache-create;
        est-before: plugin.est-before;
        est-after: plugin.est-after;
        rows: plugin.rows;
    }
}

component CallList inherits Panel {
    in property <[CallRow]> calls;
    in-out property <int> cursor;
    PanelTitle {
        text: "calls (newest first)";
    }
    if calls.length == 0: PanelNote {
        text: "no calls yet (the ledger fills as hooks, MCP and the proxy run)";
    }
    ListView {
        for c[i] in root.calls: ListRow {
            selected: i == root.cursor;
            label: c.name;
            row-height: 44px;
            activated => { root.cursor = i; }
            RowText {
                text: "\{c.when}  \{c.surface}  \{c.kind}";
                selected: i == root.cursor;
                font-size: 12px;
            }
            MetaText {
                text: c.subtitle;
                overflow: elide;
            }
        }
    }
}

component CallDetail inherits PageScroll {
    in property <bool> has-call;
    in property <CallRow> call;
    in-out property <string> view;
    in-out property <string> filter;
    callback expand-archive(string);
    callback filter-expand(string);
    gap: RtokTheme.space-2;
    MetaText {
        text: "detail";
    }
    if has-call: BodyText {
        text: call.detail;
    }
    if has-call && call.ref-id != "": HorizontalLayout {
        alignment: start;
        Button {
            accessible-label: "expand " + call.ref-id;
            text: "expand " + call.ref-id;
            clicked => { root.expand-archive(call.ref-id); }
        }
    }
    if has-call: LineEdit {
        placeholder-text: "filter";
        text <=> root.filter;
        edited => { root.filter-expand(self.text); }
    }
    if has-call: BodyText {
        text: root.view;
        font-size: 12px;
    }
}

component SessionList inherits Panel {
    in property <[SessionRow]> sessions;
    in-out property <int> cursor;
    PanelTitle {
        text: "sessions";
    }
    if sessions.length == 0: PanelNote {
        text: "no sessions yet";
    }
    ListView {
        for s[i] in root.sessions: ListRow {
            selected: i == root.cursor;
            label: "session " + s.id;
            row-height: 52px;
            activated => { root.cursor = i; }
            RowText {
                text: s.summary;
                selected: i == root.cursor;
                font-weight: 600;
            }
            MetaText {
                text: s.activity;
                overflow: elide;
            }
        }
    }
}

component SessionDetail inherits PageScroll {
    in property <bool> has-session;
    in property <SessionRow> session;
    gap: RtokTheme.space-2;
    MetaText {
        text: "detail";
    }
    if has-session: BodyText {
        text: session.detail;
    }
}

export component MainWindow inherits Window {
    title: "rtok";
    min-width: 320px;
    min-height: 480px;
    preferred-width: 960px;
    preferred-height: 640px;
    background: RtokTheme.canvas;
    default-font-family: "IBM Plex Mono";

    /// Tab bar is `model::pages()` order (D23) — never a second list.
    in-out property <[PageTab]> pages;
    in-out property <int> page-index: 0;
    out property <string> page-id: pages[page-index].id;

    in-out property <[PluginRow]> plugins;
    in-out property <int> plugin-cursor: 0;
    out property <PluginRow> selected-plugin: plugins[plugin-cursor];

    in property <int> usage-input;
    in property <int> usage-output;
    in property <int> usage-cache-read;
    in property <int> usage-cache-create;
    in property <int> usage-ctt;
    in property <string> overview-savings;
    in property <string> overview-turns;

    in-out property <[CallRow]> calls;
    in-out property <int> call-cursor: 0;
    out property <CallRow> selected-call: calls[call-cursor];

    in-out property <[SessionRow]> sessions;
    in-out property <int> session-cursor: 0;
    out property <SessionRow> selected-session: sessions[session-cursor];
    in property <string> doctor-text;
    in-out property <[string]> logs;
    in property <string> skills-header;
    in-out property <[SkillRow]> skills;
    in-out property <bool> skills-never-only: false;
    in property <string> status: "connecting";
    in property <string> error: "";
    in-out property <bool> dark: true;
    changed dark => {
        RtokTheme.dark = dark;
        Palette.color-scheme = dark ? ColorScheme.dark : ColorScheme.light;
    }
    callback theme-toggle();
    callback toggle-plugin(string, bool);
    callback expand-archive(string);
    callback filter-expand(string);
    in-out property <string> expand-text;
    in-out property <string> expand-view;
    in-out property <string> expand-filter;

    // --- Responsive shell derived from tracked window width ---
    // Use `changed width` (not a live binding to root.width) to avoid
    // layoutinfo ↔ breakpoint binding loops (Slint energy-monitor pattern).
    // sm <640 mobile | md 640–1023 rail | lg ≥1024 full sidebar
    // xl ≥1440 roomier panes | 2xl ≥1920 ultrawide padding/type
    property <length> win-w: 960px;
    property <length> win-h: 640px;
    changed width => {
        win-w = root.width;
        RtokTheme.title-size = root.width >= RtokTheme.bp-xl ? 26px : 22px;
        RtokTheme.body-size = root.width >= RtokTheme.bp-xl ? 14px : 13px;
    }
    changed height => { win-h = root.height; }
    init => {
        win-w = root.width;
        win-h = root.height;
        RtokTheme.title-size = root.width >= RtokTheme.bp-xl ? 26px : 22px;
        RtokTheme.body-size = root.width >= RtokTheme.bp-xl ? 14px : 13px;
        // Native std-widgets (LineEdit, scrollbars) follow the app theme,
        // not the OS (declarative `Global.prop:` bindings are not accepted).
        Palette.color-scheme = RtokTheme.dark ? ColorScheme.dark : ColorScheme.light;
    }

    property <bool> compact: win-w < RtokTheme.bp-sm;
    property <bool> rail: win-w >= RtokTheme.bp-sm && win-w < RtokTheme.bp-md;
    property <bool> full-nav: win-w >= RtokTheme.bp-md;
    property <bool> wide: win-w >= RtokTheme.bp-lg;
    property <bool> ultrawide: win-w >= RtokTheme.bp-xl;

    property <length> shell-pad: ultrawide ? RtokTheme.space-5 : (wide ? RtokTheme.space-4 : (compact ? RtokTheme.space-2 : RtokTheme.space-3));
    property <length> shell-gap: ultrawide ? RtokTheme.space-4 : RtokTheme.space-3;
    property <length> nav-width: rail ? RtokTheme.sidebar-w-rail : RtokTheme.sidebar-w-full;
    property <length> plugin-list-w: wide ? min(280px, win-w * 0.22) : min(240px, win-w * 0.28);
    property <length> calls-list-w: min(480px, win-w * 0.42);
    // Stacked (compact) list panels take a slice of the height; the detail
    // scrolls underneath.
    property <length> stacked-list-h: max(120px, min(220px, win-h * 0.35));
    property <length> content-max: ultrawide ? 1600px : 100000px;

    VerticalLayout {
        padding: shell-pad;
        spacing: shell-gap;

        if error != "": Card {
            border-radius: RtokTheme.radius-md;
            background: RtokTheme.surface-2;
            border-color: RtokTheme.delta;
            min-height: 36px;
            max-height: 36px;
            HorizontalLayout {
                padding-left: RtokTheme.space-3;
                padding-right: RtokTheme.space-3;
                Text {
                    text: error;
                    color: RtokTheme.delta;
                    font-size: 12px;
                    vertical-alignment: center;
                    overflow: elide;
                    horizontal-stretch: 1;
                }
            }
        }

        // Mobile: horizontal icon bar (icons only, equal buttons, 44px hits)
        if compact: Panel {
            HorizontalLayout {
                spacing: RtokTheme.space-1;
                for p[i] in pages: NavItem {
                    page-id: p.id;
                    title: p.title;
                    selected: i == page-index;
                    show-label: false;
                    icon-only: true;
                    activated => { page-index = i; }
                }
                NavItem {
                    page-id: "theme";
                    title: "theme";
                    show-label: false;
                    icon-only: true;
                    activated => { root.dark = !root.dark; root.theme-toggle(); }
                }
            }
        }

        HorizontalLayout {
            spacing: shell-gap;
            vertical-stretch: 1;

            // Tablet rail / desktop full sidebar. Logo, status dot and nav
            // icons share one 24px icon column.
            if !compact: Panel {
                width: nav-width;
                gap: 2px;

                HorizontalLayout {
                    min-height: 44px;
                    max-height: 44px;
                    padding-left: full-nav ? RtokTheme.space-2 : 0;
                    spacing: RtokTheme.space-2;
                    alignment: full-nav ? start : center;
                    IconSlot {
                        Image {
                            source: @image-url("assets/logo.svg");
                            width: 24px;
                            height: 24px;
                        }
                    }
                    if full-nav: SectionText {
                        text: "RTOK";
                        font-weight: 700;
                        vertical-alignment: center;
                    }
                }

                Rectangle {
                    min-height: 28px;
                    max-height: 28px;
                    border-radius: RtokTheme.radius-md;
                    background: RtokTheme.surface-2;
                    HorizontalLayout {
                        padding-left: full-nav ? RtokTheme.space-2 : 0;
                        padding-right: full-nav ? RtokTheme.space-2 : 0;
                        spacing: RtokTheme.space-2;
                        alignment: full-nav ? start : center;
                        IconSlot {
                            Rectangle {
                                width: 8px;
                                height: 8px;
                                border-radius: 4px;
                                background: RtokTheme.accent;
                            }
                        }
                        if full-nav: MetaText {
                            text: status;
                            vertical-alignment: center;
                            overflow: elide;
                            horizontal-stretch: 1;
                        }
                    }
                }

                Rectangle {
                    min-height: RtokTheme.space-2;
                    max-height: RtokTheme.space-2;
                }

                for p[i] in pages: NavItem {
                    page-id: p.id;
                    title: p.title;
                    selected: i == page-index;
                    show-label: full-nav;
                    icon-only: rail;
                    activated => { page-index = i; }
                }

                Rectangle {
                    vertical-stretch: 1;
                }

                NavItem {
                    page-id: "theme";
                    title: RtokTheme.dark ? "Light mode" : "Dark mode";
                    show-label: full-nav;
                    icon-only: rail;
                    activated => { root.dark = !root.dark; root.theme-toggle(); }
                }
            }

            // Content pane — stretch; readable width capped on ultrawide.
            Rectangle {
                horizontal-stretch: 1;

                if page-id == "overview": PageScroll {
                    max-content: content-max;
                    TitleText {
                        text: "overview";
                    }
                    MetaText {
                        text: "usage totals (usage rows, all apis)";
                    }
                    TokenStatsWidget {
                        input-tokens: usage-input;
                        output-tokens: usage-output;
                        cache-read: usage-cache-read;
                        cache-create: usage-cache-create;
                        show-estimates: false;
                    }
                    BodyText {
                        text: "ctt  \{usage-ctt} (input-side tok × turns after)";
                        color: RtokTheme.ink;
                    }
                    MetaText {
                        text: "saved by plugin (Measurement rows)";
                    }
                    BodyText {
                        text: overview-savings;
                    }
                    BodyText {
                        text: overview-turns;
                        color: RtokTheme.ink-subtle;
                    }
                }

                // Split pages: stacked on compact, side-by-side otherwise.
                if page-id == "plugins" && compact: VerticalLayout {
                    spacing: shell-gap;
                    PluginList {
                        min-height: stacked-list-h;
                        max-height: stacked-list-h;
                        plugins: root.plugins;
                        cursor <=> root.plugin-cursor;
                    }
                    PluginDetail {
                        vertical-stretch: 1;
                        plugin: selected-plugin;
                        toggle-plugin(id, value) => { root.toggle-plugin(id, value); }
                    }
                }

                if page-id == "plugins" && !compact: HorizontalLayout {
                    spacing: shell-gap;
                    PluginList {
                        width: plugin-list-w;
                        plugins: root.plugins;
                        cursor <=> root.plugin-cursor;
                    }
                    PluginDetail {
                        horizontal-stretch: 1;
                        max-content: content-max;
                        plugin: selected-plugin;
                        toggle-plugin(id, value) => { root.toggle-plugin(id, value); }
                    }
                }

                if page-id == "calls" && compact: VerticalLayout {
                    spacing: shell-gap;
                    CallList {
                        min-height: stacked-list-h;
                        max-height: stacked-list-h;
                        calls: root.calls;
                        cursor <=> root.call-cursor;
                    }
                    CallDetail {
                        vertical-stretch: 1;
                        has-call: calls.length > 0;
                        call: selected-call;
                        view <=> root.expand-view;
                        filter <=> root.expand-filter;
                        expand-archive(id) => { root.expand-archive(id); }
                        filter-expand(s) => { root.filter-expand(s); }
                    }
                }

                if page-id == "calls" && !compact: HorizontalLayout {
                    spacing: shell-gap;
                    CallList {
                        width: calls-list-w;
                        calls: root.calls;
                        cursor <=> root.call-cursor;
                    }
                    CallDetail {
                        horizontal-stretch: 1;
                        max-content: content-max;
                        has-call: calls.length > 0;
                        call: selected-call;
                        view <=> root.expand-view;
                        filter <=> root.expand-filter;
                        expand-archive(id) => { root.expand-archive(id); }
                        filter-expand(s) => { root.filter-expand(s); }
                    }
                }

                if page-id == "sessions" && compact: VerticalLayout {
                    spacing: shell-gap;
                    SessionList {
                        min-height: stacked-list-h;
                        max-height: stacked-list-h;
                        sessions: root.sessions;
                        cursor <=> root.session-cursor;
                    }
                    SessionDetail {
                        vertical-stretch: 1;
                        has-session: sessions.length > 0;
                        session: selected-session;
                    }
                }

                if page-id == "sessions" && !compact: HorizontalLayout {
                    spacing: shell-gap;
                    SessionList {
                        width: calls-list-w;
                        sessions: root.sessions;
                        cursor <=> root.session-cursor;
                    }
                    SessionDetail {
                        horizontal-stretch: 1;
                        max-content: content-max;
                        has-session: sessions.length > 0;
                        session: selected-session;
                    }
                }

                if page-id == "doctor": PageScroll {
                    max-content: content-max;
                    gap: RtokTheme.space-2;
                    TitleText {
                        text: "doctor";
                    }
                    BodyText {
                        text: doctor-text;
                    }
                }

                if page-id == "logs": PageScroll {
                    max-content: content-max;
                    gap: RtokTheme.space-1;
                    TitleText {
                        text: "logs";
                    }
                    if logs.length == 0: BodyText {
                        text: "no logs yet";
                    }
                    for line in logs: BodyText {
                        text: line;
                        font-size: ultrawide ? 13px : 12px;
                    }
                }

                if page-id == "skills": PageScroll {
                    max-content: content-max;
                    gap: RtokTheme.space-2;
                    TitleText {
                        text: "skills";
                    }
                    BodyText {
                        text: skills-header;
                    }
                    CheckBox {
                        accessible-label: "never invoked only";
                        text: "never invoked only";
                        checked: skills-never-only;
                        toggled() => { skills-never-only = self.checked; }
                    }
                    if skills.length == 0: BodyText {
                        text: "no skills listed";
                    }
                    for s in skills: VerticalLayout {
                        if !skills-never-only || s.never: ListRow {
                            label: "skill " + s.name;
                            RowText {
                                text: s.summary;
                                color: s.never ? RtokTheme.ink-muted : RtokTheme.ink;
                            }
                        }
                    }
                }
            }
        }
    }
}
