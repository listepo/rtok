import { HorizontalBox, VerticalBox, ListView, ScrollView } from "std-widgets.slint";
import { RtokTheme } from "theme.slint";

// Bundled IBM Plex Mono (OFL) — weights 400 / 600 / 700
import "./fonts/IBMPlexMono-Regular.ttf";
import "./fonts/IBMPlexMono-SemiBold.ttf";
import "./fonts/IBMPlexMono-Bold.ttf";

export struct PageTab {
    id: string,
    title: string,
}

export struct PluginRow {
    id: string,
    title: string,
    summary: string,
    fields: string,
    enabled: bool,
    saves-tokens: bool,
    input-tokens: int,
    output-tokens: int,
    cache-read: int,
    cache-create: int,
    est-before: int,
    est-after: int,
    rows: int,
}

export struct CallRow {
    when: string,
    surface: string,
    kind: string,
    name: string,
    session: string,
    ms: string,
    tokens: string,
    subtitle: string,
    detail: string,
}

export struct SessionRow {
    id: string,
    host: string,
    provider: string,
    model: string,
    input: int,
    output: int,
    cache-create: int,
    cache-read: int,
    live: bool,
    status: string,
    activity: string,
    summary: string,
}

component MetricCell inherits VerticalBox {
    in property <string> label;
    in property <string> value;
    in property <color> value-color: RtokTheme.ink;
    in property <length> value-size: 18px;
    Text {
        text: label;
        color: RtokTheme.ink-muted;
        font-size: 11px;
        font-family: "IBM Plex Mono";
    }
    Text {
        text: value;
        color: value-color;
        font-size: value-size;
        font-weight: 600;
        font-family: "IBM Plex Mono";
    }
}

/// Shared stats strip for plugins that record Measurement / usage rows.
/// Wraps to 2×3 when the strip itself is narrow (< 520px).
export component TokenStatsWidget inherits Rectangle {
    in property <int> input-tokens;
    in property <int> output-tokens;
    in property <int> cache-read;
    in property <int> cache-create;
    in property <int> est-before;
    in property <int> est-after;
    in property <int> rows;
    property <length> strip-w: 800px;
    changed width => { strip-w = root.width; }
    init => { strip-w = root.width; }
    property <bool> narrow: strip-w < 520px;
    property <length> value-size: narrow ? 16px : 18px;
    border-radius: RtokTheme.radius-md;
    background: RtokTheme.surface-1;
    border-width: 1px;
    border-color: RtokTheme.hairline;

    if narrow: VerticalBox {
        padding: RtokTheme.space-3;
        spacing: RtokTheme.space-3;
        HorizontalBox {
            spacing: RtokTheme.space-3;
            alignment: space-around;
            MetricCell { label: "input"; value: "\{input-tokens}"; value-size: value-size; }
            MetricCell { label: "output"; value: "\{output-tokens}"; value-size: value-size; }
            MetricCell { label: "cache read"; value: "\{root.cache-read}"; value-size: value-size; }
        }
        HorizontalBox {
            spacing: RtokTheme.space-3;
            alignment: space-around;
            MetricCell { label: "cache create"; value: "\{root.cache-create}"; value-size: value-size; }
            MetricCell {
                label: "est before → after";
                value: "\{est-before} → \{est-after}";
                value-color: RtokTheme.accent;
                value-size: value-size;
            }
            MetricCell { label: "rows"; value: "\{rows}"; value-size: value-size; }
        }
    }

    if !narrow: HorizontalBox {
        padding: RtokTheme.space-3;
        spacing: RtokTheme.space-4;
        alignment: space-around;
        MetricCell { label: "input"; value: "\{input-tokens}"; value-size: value-size; }
        MetricCell { label: "output"; value: "\{output-tokens}"; value-size: value-size; }
        MetricCell { label: "cache read"; value: "\{root.cache-read}"; value-size: value-size; }
        MetricCell { label: "cache create"; value: "\{root.cache-create}"; value-size: value-size; }
        MetricCell {
            label: "est before → after";
            value: "\{est-before} → \{est-after}";
            value-color: RtokTheme.accent;
            value-size: value-size;
        }
        MetricCell { label: "rows"; value: "\{rows}"; value-size: value-size; }
    }
}

component PageIcon inherits Image {
    in property <string> page-id;
    in property <color> tint: RtokTheme.ink-muted;
    width: 16px;
    height: 16px;
    colorize: tint;
    source:
        page-id == "overview" ? @image-url("icons/overview.svg") :
        page-id == "plugins" ? @image-url("icons/plugins.svg") :
        page-id == "calls" ? @image-url("icons/calls.svg") :
        page-id == "sessions" ? @image-url("icons/sessions.svg") :
        page-id == "doctor" ? @image-url("icons/doctor.svg") :
        page-id == "logs" ? @image-url("icons/logs.svg") :
        @image-url("icons/overview.svg");
}

/// Nav row used in full sidebar, rail, and mobile icon bar.
component NavItem inherits Rectangle {
    in property <string> page-id;
    in property <string> title;
    in property <bool> selected;
    in property <bool> show-label: true;
    in property <bool> icon-only: false;
    callback activated;
    height: icon-only ? 44px : 36px;
    border-radius: RtokTheme.radius-md;
    background: selected ? RtokTheme.accent-muted : transparent;
    TouchArea {
        clicked => { root.activated(); }
    }
    HorizontalBox {
        padding-left: show-label ? RtokTheme.space-2 : 0;
        spacing: RtokTheme.space-2;
        alignment: show-label ? start : center;
        PageIcon {
            page-id: root.page-id;
            tint: selected ? RtokTheme.accent : RtokTheme.ink-muted;
        }
        if show-label: Text {
            text: title;
            color: selected ? RtokTheme.accent : RtokTheme.ink-muted;
            font-family: "IBM Plex Mono";
            vertical-alignment: center;
        }
    }
}

export component MainWindow inherits Window {
    title: "rtok";
    min-width: 320px;
    min-height: 480px;
    preferred-width: 960px;
    preferred-height: 640px;
    background: RtokTheme.canvas;
    default-font-family: "IBM Plex Mono";

    /// Tab bar is `model::pages()` order (D23) — never a second list.
    in-out property <[PageTab]> pages;
    in-out property <int> page-index: 0;
    property <string> page-id: pages[page-index].id;

    in-out property <[PluginRow]> plugins;
    in-out property <int> plugin-cursor: 0;
    property <PluginRow> selected-plugin: plugins[plugin-cursor];

    in property <int> usage-input;
    in property <int> usage-output;
    in property <int> usage-cache-read;
    in property <int> usage-cache-create;
    in property <int> usage-ctt;
    in property <string> overview-savings;
    in property <string> overview-turns;

    in-out property <[CallRow]> calls;
    in-out property <int> call-cursor: 0;
    property <CallRow> selected-call: calls[call-cursor];

    in-out property <[SessionRow]> sessions;
    in property <string> doctor-text;
    in-out property <[string]> logs;
    in property <string> status: "connecting";

    // --- Responsive shell derived from tracked window width ---
    // Use `changed width` (not a live binding to root.width) to avoid
    // layoutinfo ↔ breakpoint binding loops (Slint energy-monitor pattern).
    // sm <640 mobile | md 640–1023 rail | lg ≥1024 full sidebar
    // xl ≥1440 roomier panes | 2xl ≥1920 ultrawide padding/type
    property <length> win-w: 960px;
    property <length> win-h: 640px;
    changed width => { win-w = root.width; }
    changed height => { win-h = root.height; }
    init => {
        win-w = root.width;
        win-h = root.height;
    }

    property <bool> compact: win-w < RtokTheme.bp-sm;
    property <bool> rail: win-w >= RtokTheme.bp-sm && win-w < RtokTheme.bp-md;
    property <bool> full-nav: win-w >= RtokTheme.bp-md;
    property <bool> wide: win-w >= RtokTheme.bp-lg;
    property <bool> ultrawide: win-w >= RtokTheme.bp-xl;

    property <length> shell-pad: ultrawide ? RtokTheme.space-5 : (wide ? RtokTheme.space-4 : (compact ? RtokTheme.space-2 : RtokTheme.space-3));
    property <length> shell-gap: ultrawide ? RtokTheme.space-4 : RtokTheme.space-3;
    property <length> title-size: ultrawide ? 26px : 22px;
    property <length> body-size: ultrawide ? 14px : 13px;
    property <length> nav-width: rail ? RtokTheme.sidebar-w-rail : RtokTheme.sidebar-w-full;
    property <length> plugin-list-w: wide ? min(280px, win-w * 0.22) : min(240px, win-w * 0.28);
    property <length> calls-list-w: min(480px, win-w * 0.42);
    property <length> content-max: ultrawide ? 1600px : 10000px;

    VerticalBox {
        padding: shell-pad;
        spacing: shell-gap;
        alignment: stretch;

        // Mobile: horizontal icon bar (icons only, ≥44px hits)
        if compact: Rectangle {
            height: 52px;
            border-radius: RtokTheme.radius-lg;
            background: RtokTheme.surface-1;
            border-width: 1px;
            border-color: RtokTheme.hairline;
            HorizontalBox {
                padding: RtokTheme.space-1;
                spacing: RtokTheme.space-1;
                alignment: stretch;
                Image {
                    source: @image-url("assets/logo.svg");
                    width: 22px;
                    height: 22px;
                    vertical-alignment: center;
                }
                for p[i] in pages: NavItem {
                    page-id: p.id;
                    title: p.title;
                    selected: i == page-index;
                    show-label: false;
                    icon-only: true;
                    activated => { page-index = i; }
                }
                Rectangle {
                    width: 44px;
                    height: 44px;
                    border-radius: RtokTheme.radius-md;
                    TouchArea {
                        clicked => { RtokTheme.dark = !RtokTheme.dark; }
                    }
                    Image {
                        source: @image-url("icons/theme.svg");
                        width: 16px;
                        height: 16px;
                        colorize: RtokTheme.ink-muted;
                        x: (parent.width - self.width) / 2;
                        y: (parent.height - self.height) / 2;
                    }
                }
            }
        }

        HorizontalBox {
            spacing: shell-gap;
            alignment: stretch;

            // Tablet rail / desktop full sidebar
            if !compact: Rectangle {
                width: nav-width;
                border-radius: RtokTheme.radius-lg;
                background: RtokTheme.surface-1;
                border-width: 1px;
                border-color: RtokTheme.hairline;
                VerticalBox {
                    padding: RtokTheme.space-2;
                    spacing: RtokTheme.space-2;

                    HorizontalBox {
                        spacing: RtokTheme.space-2;
                        alignment: full-nav ? start : center;
                        Image {
                            source: @image-url("assets/logo.svg");
                            width: 24px;
                            height: 24px;
                        }
                        if full-nav: Text {
                            text: "RTOK";
                            color: RtokTheme.ink;
                            font-size: 16px;
                            font-weight: 700;
                            font-family: "IBM Plex Mono";
                            vertical-alignment: center;
                        }
                    }

                    if full-nav: Rectangle {
                        height: 28px;
                        border-radius: RtokTheme.radius-md;
                        background: RtokTheme.surface-2;
                        HorizontalBox {
                            padding-left: RtokTheme.space-2;
                            spacing: RtokTheme.space-2;
                            alignment: start;
                            Rectangle {
                                width: 8px;
                                height: 8px;
                                border-radius: 4px;
                                background: RtokTheme.accent;
                                y: parent.height / 2 - self.height / 2;
                            }
                            Text {
                                text: status;
                                color: RtokTheme.ink-muted;
                                font-size: 11px;
                                font-family: "IBM Plex Mono";
                                vertical-alignment: center;
                            }
                        }
                    }

                    ListView {
                        for p[i] in pages: NavItem {
                            page-id: p.id;
                            title: p.title;
                            selected: i == page-index;
                            show-label: full-nav;
                            icon-only: rail;
                            activated => { page-index = i; }
                        }
                    }

                    Rectangle {
                        height: rail ? 44px : 36px;
                        border-radius: RtokTheme.radius-md;
                        background: transparent;
                        TouchArea {
                            clicked => { RtokTheme.dark = !RtokTheme.dark; }
                        }
                        HorizontalBox {
                            padding-left: full-nav ? RtokTheme.space-2 : 0;
                            spacing: RtokTheme.space-2;
                            alignment: full-nav ? start : center;
                            Image {
                                source: @image-url("icons/theme.svg");
                                width: 16px;
                                height: 16px;
                                colorize: RtokTheme.ink-muted;
                            }
                            if full-nav: Text {
                                text: RtokTheme.dark ? "Light mode" : "Dark mode";
                                color: RtokTheme.ink-muted;
                                font-family: "IBM Plex Mono";
                                font-size: 12px;
                                vertical-alignment: center;
                            }
                        }
                    }
                }
            }

            // Content pane — stretch; cap readable width on ultrawide via max on metric strips / prose
            Rectangle {
                horizontal-stretch: 1;
                background: transparent;

                if page-id == "overview": ScrollView {
                    VerticalBox {
                        padding: wide ? RtokTheme.space-2 : 0;
                        spacing: shell-gap;
                        max-width: content-max;
                        Text {
                            text: "overview";
                            color: RtokTheme.ink;
                            font-size: title-size;
                            font-weight: 700;
                            font-family: "IBM Plex Mono";
                        }
                        Text {
                            text: "usage totals (usage rows, all apis)";
                            color: RtokTheme.ink-muted;
                            font-size: 11px;
                            font-family: "IBM Plex Mono";
                        }
                        TokenStatsWidget {
                            input-tokens: usage-input;
                            output-tokens: usage-output;
                            cache-read: usage-cache-read;
                            cache-create: usage-cache-create;
                            est-before: 0;
                            est-after: 0;
                            rows: 0;
                        }
                        Text {
                            text: "ctt  \{usage-ctt} (input-side tok × turns after)";
                            color: RtokTheme.ink;
                            font-size: body-size;
                            font-family: "IBM Plex Mono";
                        }
                        Text {
                            text: "saved by plugin (Measurement rows)";
                            color: RtokTheme.ink-muted;
                            font-size: 11px;
                            font-family: "IBM Plex Mono";
                        }
                        Text {
                            text: overview-savings;
                            color: RtokTheme.ink-muted;
                            wrap: word-wrap;
                            font-size: body-size;
                            font-family: "IBM Plex Mono";
                        }
                        Text {
                            text: overview-turns;
                            color: RtokTheme.ink-subtle;
                            wrap: word-wrap;
                            font-size: body-size;
                            font-family: "IBM Plex Mono";
                        }
                    }
                }

                // Plugins: stacked on compact, side-by-side otherwise
                if page-id == "plugins" && compact: VerticalBox {
                    spacing: shell-gap;
                    Rectangle {
                        height: min(200px, win-h * 0.35);
                        border-radius: RtokTheme.radius-lg;
                        background: RtokTheme.surface-1;
                        border-width: 1px;
                        border-color: RtokTheme.hairline;
                        VerticalBox {
                            padding: RtokTheme.space-2;
                            Text {
                                text: "plugins";
                                color: RtokTheme.ink;
                                font-size: 16px;
                                font-weight: 600;
                                font-family: "IBM Plex Mono";
                            }
                            ListView {
                                for p[i] in plugins: Rectangle {
                                    height: 36px;
                                    border-radius: RtokTheme.radius-md;
                                    background: i == plugin-cursor ? RtokTheme.accent-muted : transparent;
                                    TouchArea {
                                        clicked => { plugin-cursor = i; }
                                    }
                                    HorizontalBox {
                                        padding-left: RtokTheme.space-2;
                                        alignment: start;
                                        Text {
                                            text: p.title;
                                            color: i == plugin-cursor ? RtokTheme.accent : (p.enabled ? RtokTheme.ink : RtokTheme.ink-subtle);
                                            font-family: "IBM Plex Mono";
                                            vertical-alignment: center;
                                        }
                                    }
                                }
                            }
                        }
                    }
                    ScrollView {
                        VerticalBox {
                            spacing: shell-gap;
                            Text {
                                text: selected-plugin.title;
                                color: RtokTheme.ink;
                                font-size: title-size;
                                font-weight: 700;
                                font-family: "IBM Plex Mono";
                            }
                            Text {
                                text: selected-plugin.enabled ? "enabled" : "disabled";
                                color: selected-plugin.enabled ? RtokTheme.success : RtokTheme.ink-subtle;
                                font-family: "IBM Plex Mono";
                            }
                            Text {
                                text: selected-plugin.summary;
                                color: RtokTheme.ink-muted;
                                wrap: word-wrap;
                                font-size: body-size;
                                font-family: "IBM Plex Mono";
                            }
                            Text {
                                text: selected-plugin.fields;
                                color: RtokTheme.ink-subtle;
                                wrap: word-wrap;
                                font-size: body-size;
                                font-family: "IBM Plex Mono";
                            }
                            if selected-plugin.saves-tokens: TokenStatsWidget {
                                input-tokens: selected-plugin.input-tokens;
                                output-tokens: selected-plugin.output-tokens;
                                cache-read: selected-plugin.cache-read;
                                cache-create: selected-plugin.cache-create;
                                est-before: selected-plugin.est-before;
                                est-after: selected-plugin.est-after;
                                rows: selected-plugin.rows;
                            }
                        }
                    }
                }

                if page-id == "plugins" && !compact: HorizontalBox {
                    spacing: shell-gap;
                    Rectangle {
                        width: plugin-list-w;
                        border-radius: RtokTheme.radius-lg;
                        background: RtokTheme.surface-1;
                        border-width: 1px;
                        border-color: RtokTheme.hairline;
                        VerticalBox {
                            padding: RtokTheme.space-2;
                            Text {
                                text: "plugins";
                                color: RtokTheme.ink;
                                font-size: 16px;
                                font-weight: 600;
                                font-family: "IBM Plex Mono";
                            }
                            ListView {
                                for p[i] in plugins: Rectangle {
                                    height: 36px;
                                    border-radius: RtokTheme.radius-md;
                                    background: i == plugin-cursor ? RtokTheme.accent-muted : transparent;
                                    TouchArea {
                                        clicked => { plugin-cursor = i; }
                                    }
                                    HorizontalBox {
                                        padding-left: RtokTheme.space-2;
                                        alignment: start;
                                        Text {
                                            text: p.title;
                                            color: i == plugin-cursor ? RtokTheme.accent : (p.enabled ? RtokTheme.ink : RtokTheme.ink-subtle);
                                            font-family: "IBM Plex Mono";
                                            vertical-alignment: center;
                                        }
                                    }
                                }
                            }
                        }
                    }
                    ScrollView {
                        horizontal-stretch: 1;
                        VerticalBox {
                            spacing: shell-gap;
                            max-width: content-max;
                            Text {
                                text: selected-plugin.title;
                                color: RtokTheme.ink;
                                font-size: title-size;
                                font-weight: 700;
                                font-family: "IBM Plex Mono";
                            }
                            Text {
                                text: selected-plugin.enabled ? "enabled" : "disabled";
                                color: selected-plugin.enabled ? RtokTheme.success : RtokTheme.ink-subtle;
                                font-family: "IBM Plex Mono";
                            }
                            Text {
                                text: selected-plugin.summary;
                                color: RtokTheme.ink-muted;
                                wrap: word-wrap;
                                font-size: body-size;
                                font-family: "IBM Plex Mono";
                            }
                            Text {
                                text: selected-plugin.fields;
                                color: RtokTheme.ink-subtle;
                                wrap: word-wrap;
                                font-size: body-size;
                                font-family: "IBM Plex Mono";
                            }
                            if selected-plugin.saves-tokens: TokenStatsWidget {
                                input-tokens: selected-plugin.input-tokens;
                                output-tokens: selected-plugin.output-tokens;
                                cache-read: selected-plugin.cache-read;
                                cache-create: selected-plugin.cache-create;
                                est-before: selected-plugin.est-before;
                                est-after: selected-plugin.est-after;
                                rows: selected-plugin.rows;
                            }
                        }
                    }
                }

                // Calls: stacked on compact, side-by-side otherwise
                if page-id == "calls" && compact: VerticalBox {
                    spacing: shell-gap;
                    Rectangle {
                        height: min(220px, win-h * 0.4);
                        border-radius: RtokTheme.radius-lg;
                        background: RtokTheme.surface-1;
                        border-width: 1px;
                        border-color: RtokTheme.hairline;
                        VerticalBox {
                            padding: RtokTheme.space-2;
                            Text {
                                text: "calls (newest first)";
                                color: RtokTheme.ink;
                                font-size: 16px;
                                font-weight: 600;
                                font-family: "IBM Plex Mono";
                            }
                            if calls.length == 0: Text {
                                text: "no calls yet (the ledger fills as hooks, MCP and the proxy run)";
                                color: RtokTheme.ink-muted;
                                wrap: word-wrap;
                                font-family: "IBM Plex Mono";
                            }
                            ListView {
                                for c[i] in calls: Rectangle {
                                    height: 40px;
                                    border-radius: RtokTheme.radius-md;
                                    background: i == call-cursor ? RtokTheme.accent-muted : transparent;
                                    TouchArea {
                                        clicked => { call-cursor = i; }
                                    }
                                    VerticalBox {
                                        padding-left: RtokTheme.space-2;
                                        spacing: 0;
                                        Text {
                                            text: "\{c.when}  \{c.surface}  \{c.kind}";
                                            color: i == call-cursor ? RtokTheme.accent : RtokTheme.ink;
                                            font-size: 12px;
                                            font-family: "IBM Plex Mono";
                                        }
                                        Text {
                                            text: c.subtitle;
                                            color: RtokTheme.ink-muted;
                                            font-size: 11px;
                                            font-family: "IBM Plex Mono";
                                        }
                                    }
                                }
                            }
                        }
                    }
                    ScrollView {
                        VerticalBox {
                            spacing: RtokTheme.space-2;
                            Text {
                                text: "detail";
                                color: RtokTheme.ink-muted;
                                font-size: 11px;
                                font-family: "IBM Plex Mono";
                            }
                            if calls.length == 0: Text { text: ""; }
                            if calls.length > 0: Text {
                                text: selected-call.detail;
                                color: RtokTheme.ink-muted;
                                wrap: word-wrap;
                                font-size: body-size;
                                font-family: "IBM Plex Mono";
                            }
                        }
                    }
                }

                if page-id == "calls" && !compact: HorizontalBox {
                    spacing: shell-gap;
                    Rectangle {
                        width: calls-list-w;
                        border-radius: RtokTheme.radius-lg;
                        background: RtokTheme.surface-1;
                        border-width: 1px;
                        border-color: RtokTheme.hairline;
                        VerticalBox {
                            padding: RtokTheme.space-2;
                            Text {
                                text: "calls (newest first)";
                                color: RtokTheme.ink;
                                font-size: 16px;
                                font-weight: 600;
                                font-family: "IBM Plex Mono";
                            }
                            if calls.length == 0: Text {
                                text: "no calls yet (the ledger fills as hooks, MCP and the proxy run)";
                                color: RtokTheme.ink-muted;
                                wrap: word-wrap;
                                font-family: "IBM Plex Mono";
                            }
                            ListView {
                                for c[i] in calls: Rectangle {
                                    height: 40px;
                                    border-radius: RtokTheme.radius-md;
                                    background: i == call-cursor ? RtokTheme.accent-muted : transparent;
                                    TouchArea {
                                        clicked => { call-cursor = i; }
                                    }
                                    VerticalBox {
                                        padding-left: RtokTheme.space-2;
                                        spacing: 0;
                                        Text {
                                            text: "\{c.when}  \{c.surface}  \{c.kind}";
                                            color: i == call-cursor ? RtokTheme.accent : RtokTheme.ink;
                                            font-size: 12px;
                                            font-family: "IBM Plex Mono";
                                        }
                                        Text {
                                            text: c.subtitle;
                                            color: RtokTheme.ink-muted;
                                            font-size: 11px;
                                            font-family: "IBM Plex Mono";
                                        }
                                    }
                                }
                            }
                        }
                    }
                    ScrollView {
                        horizontal-stretch: 1;
                        VerticalBox {
                            spacing: RtokTheme.space-2;
                            max-width: content-max;
                            Text {
                                text: "detail";
                                color: RtokTheme.ink-muted;
                                font-size: 11px;
                                font-family: "IBM Plex Mono";
                            }
                            if calls.length == 0: Text { text: ""; }
                            if calls.length > 0: Text {
                                text: selected-call.detail;
                                color: RtokTheme.ink-muted;
                                wrap: word-wrap;
                                font-size: body-size;
                                font-family: "IBM Plex Mono";
                            }
                        }
                    }
                }

                if page-id == "sessions": ScrollView {
                    VerticalBox {
                        spacing: RtokTheme.space-2;
                        max-width: content-max;
                        Text {
                            text: "sessions";
                            color: RtokTheme.ink;
                            font-size: title-size;
                            font-weight: 700;
                            font-family: "IBM Plex Mono";
                        }
                        if sessions.length == 0: Text {
                            text: "no sessions yet";
                            color: RtokTheme.ink-muted;
                            font-family: "IBM Plex Mono";
                        }
                        for s in sessions: Rectangle {
                            border-radius: RtokTheme.radius-md;
                            background: RtokTheme.surface-1;
                            border-width: 1px;
                            border-color: RtokTheme.hairline;
                            VerticalBox {
                                padding: wide ? RtokTheme.space-3 : 10px;
                                spacing: 2px;
                                Text {
                                    text: s.summary;
                                    color: RtokTheme.ink;
                                    font-weight: 600;
                                    font-size: body-size;
                                    font-family: "IBM Plex Mono";
                                }
                                Text {
                                    text: s.activity;
                                    color: RtokTheme.ink-muted;
                                    font-size: 11px;
                                    font-family: "IBM Plex Mono";
                                }
                                Text {
                                    text: s.status;
                                    color: RtokTheme.ink-muted;
                                    font-size: 12px;
                                    font-family: "IBM Plex Mono";
                                }
                            }
                        }
                    }
                }

                if page-id == "doctor": ScrollView {
                    VerticalBox {
                        spacing: RtokTheme.space-2;
                        max-width: content-max;
                        Text {
                            text: "doctor";
                            color: RtokTheme.ink;
                            font-size: title-size;
                            font-weight: 700;
                            font-family: "IBM Plex Mono";
                        }
                        Text {
                            text: doctor-text;
                            color: RtokTheme.ink-muted;
                            wrap: word-wrap;
                            font-size: body-size;
                            font-family: "IBM Plex Mono";
                        }
                    }
                }

                if page-id == "logs": ScrollView {
                    VerticalBox {
                        spacing: RtokTheme.space-1;
                        max-width: content-max;
                        Text {
                            text: "logs";
                            color: RtokTheme.ink;
                            font-size: title-size;
                            font-weight: 700;
                            font-family: "IBM Plex Mono";
                        }
                        if logs.length == 0: Text {
                            text: "no logs yet";
                            color: RtokTheme.ink-muted;
                            font-family: "IBM Plex Mono";
                        }
                        for line in logs: Text {
                            text: line;
                            color: RtokTheme.ink-muted;
                            wrap: word-wrap;
                            font-size: ultrawide ? 13px : 12px;
                            font-family: "IBM Plex Mono";
                        }
                    }
                }
            }
        }
    }
}
