import { Button, CheckBox, HorizontalBox, VerticalBox, ListView, ScrollView, LineEdit, Palette } from "std-widgets.slint";

import { RtokTheme } from "theme.slint";
import { BodyText, Card, ListRow, MetaText, NavItem, PageIcon, SectionText, TitleText } from "kit.slint";

// Bundled IBM Plex Mono (OFL) — weights 400 / 600 / 700
import "./fonts/IBMPlexMono-Regular.ttf";
import "./fonts/IBMPlexMono-SemiBold.ttf";
import "./fonts/IBMPlexMono-Bold.ttf";

export struct PageTab {
    id: string,
    title: string,
}

export struct PluginRow {
    id: string,
    title: string,
    summary: string,
    fields: string,
    enabled: bool,
    saves-tokens: bool,
    input-tokens: int,
    output-tokens: int,
    cache-read: int,
    cache-create: int,
    est-before: int,
    est-after: int,
    rows: int,
}

export struct CallRow {
    when: string,
    surface: string,
    kind: string,
    name: string,
    session: string,
    ms: string,
    tokens: string,
    subtitle: string,
    detail: string,
    ref-id: string,
}

component CallArchive inherits VerticalBox {
    in property <string> ref-id;
    in-out property <string> view;
    in-out property <string> filter;
    callback expand-archive(string);
    callback filter-expand(string);
    spacing: RtokTheme.space-2;
    if ref-id != "": Button {
        accessible-label: "expand " + ref-id;
        text: "expand " + ref-id;
        clicked => { root.expand-archive(root.ref-id); }
    }
    LineEdit {
        placeholder-text: "filter";
        text <=> root.filter;
        edited => { root.filter-expand(self.text); }
    }
    BodyText {
        text: root.view;
        font-size: 12px;
    }
}

export struct SkillRow {
    name: string,
    source: string,
    desc-chars: string,
    body-bytes: string,
    invocations: string,
    resident: string,
    last-invoked: string,
    never: bool,
    summary: string,
}

export struct SessionRow {
    id: string,
    host: string,
    provider: string,
    model: string,
    input: int,
    output: int,
    cache-create: int,
    cache-read: int,
    live: bool,
    status: string,
    activity: string,
    summary: string,
    detail: string,
}

component MetricCell inherits VerticalBox {
    in property <string> label;
    in property <string> value;
    in property <color> value-color: RtokTheme.ink;
    in property <length> value-size: 18px;
    // Fixed pair, centered as one block — a stretched default spreads
    // label and value to the cell edges (probe-verified).
    alignment: center;
    spacing: RtokTheme.space-1;
    MetaText {
        text: label;
    }
    Text {
        text: value;
        color: value-color;
        font-size: value-size;
        font-weight: 600;
    }
}

/// Shared stats strip for plugins that record Measurement / usage rows.
/// Wraps to 2×3 when the strip itself is narrow (< 520px).
export component TokenStatsWidget inherits Card {
    in property <int> input-tokens;
    in property <int> output-tokens;
    in property <int> cache-read;
    in property <int> cache-create;
    in property <int> est-before;
    in property <int> est-after;
    in property <int> rows;
    property <length> strip-w: 800px;
    changed width => { strip-w = root.width; }
    init => { strip-w = root.width; }
    property <bool> narrow: strip-w < 760px;
    property <length> value-size: narrow ? 16px : 18px;
    border-radius: RtokTheme.radius-md;
    // The card hugs its rows: `if`-only children report a zero preferred
    // height here, so the height comes from the wrapper's layoutinfo.
    min-height: stats.preferred-height;
    preferred-height: stats.preferred-height;
    stats := VerticalLayout {
        if narrow: VerticalBox {
            padding: RtokTheme.space-3;
            spacing: RtokTheme.space-2;
            HorizontalBox {
                spacing: RtokTheme.space-3;
                alignment: space-around;
                MetricCell { label: "input"; value: "\{input-tokens}"; value-size: value-size; }
                MetricCell { label: "output"; value: "\{output-tokens}"; value-size: value-size; }
                MetricCell { label: "cache read"; value: "\{root.cache-read}"; value-size: value-size; }
            }
            HorizontalBox {
                spacing: RtokTheme.space-3;
                alignment: space-around;
                MetricCell { label: "cache create"; value: "\{root.cache-create}"; value-size: value-size; }
                MetricCell {
                    label: "est before → after";
                    value: "\{est-before} → \{est-after}";
                    value-color: RtokTheme.accent;
                    value-size: value-size;
                }
                MetricCell { label: "rows"; value: "\{rows}"; value-size: value-size; }
            }
        }

        if !narrow: HorizontalBox {
            padding: RtokTheme.space-3;
            spacing: RtokTheme.space-4;
            alignment: space-around;
            MetricCell { label: "input"; value: "\{input-tokens}"; value-size: value-size; }
            MetricCell { label: "output"; value: "\{output-tokens}"; value-size: value-size; }
            MetricCell { label: "cache read"; value: "\{root.cache-read}"; value-size: value-size; }
            MetricCell { label: "cache create"; value: "\{root.cache-create}"; value-size: value-size; }
            MetricCell {
                label: "est before → after";
                value: "\{est-before} → \{est-after}";
                value-color: RtokTheme.accent;
                value-size: value-size;
            }
            MetricCell { label: "rows"; value: "\{rows}"; value-size: value-size; }
        }
    }
}

/// Same toggle as the TUI Plugins tab (T60.5): click sends `plugins.<id>.enabled`.
/// Inherits the std `CheckBox` — focus, hover and accessibility come from the widget.
component PluginEnableToggle inherits CheckBox {
    in property <bool> on;
    in property <string> plugin-id;
    callback enable(bool);
    accessible-label: "toggle " + plugin-id;
    text: "enabled";
    checked: root.on;
    toggled() => { root.enable(self.checked); }
}

export component MainWindow inherits Window {
    title: "rtok";
    min-width: 320px;
    min-height: 480px;
    preferred-width: 960px;
    preferred-height: 640px;
    background: RtokTheme.canvas;
    default-font-family: "IBM Plex Mono";

    /// Tab bar is `model::pages()` order (D23) — never a second list.
    in-out property <[PageTab]> pages;
    in-out property <int> page-index: 0;
    out property <string> page-id: pages[page-index].id;

    in-out property <[PluginRow]> plugins;
    in-out property <int> plugin-cursor: 0;
    out property <PluginRow> selected-plugin: plugins[plugin-cursor];

    in property <int> usage-input;
    in property <int> usage-output;
    in property <int> usage-cache-read;
    in property <int> usage-cache-create;
    in property <int> usage-ctt;
    in property <string> overview-savings;
    in property <string> overview-turns;

    in-out property <[CallRow]> calls;
    in-out property <int> call-cursor: 0;
    out property <CallRow> selected-call: calls[call-cursor];

    in-out property <[SessionRow]> sessions;
    in-out property <int> session-cursor: 0;
    out property <SessionRow> selected-session: sessions[session-cursor];
    in property <string> doctor-text;
    in-out property <[string]> logs;
    in property <string> skills-header;
    in-out property <[SkillRow]> skills;
    in-out property <bool> skills-never-only: false;
    in property <string> status: "connecting";
    in property <string> error: "";
    in-out property <bool> dark: true;
    changed dark => {
        RtokTheme.dark = dark;
        Palette.color-scheme = dark ? ColorScheme.dark : ColorScheme.light;
    }
    callback theme-toggle();
    callback toggle-plugin(string, bool);
    callback expand-archive(string);
    callback filter-expand(string);
    in-out property <string> expand-text;
    in-out property <string> expand-view;
    in-out property <string> expand-filter;

    // --- Responsive shell derived from tracked window width ---
    // Use `changed width` (not a live binding to root.width) to avoid
    // layoutinfo ↔ breakpoint binding loops (Slint energy-monitor pattern).
    // sm <640 mobile | md 640–1023 rail | lg ≥1024 full sidebar
    // xl ≥1440 roomier panes | 2xl ≥1920 ultrawide padding/type
    property <length> win-w: 960px;
    property <length> win-h: 640px;
    changed width => {
        win-w = root.width;
        RtokTheme.title-size = root.width >= RtokTheme.bp-xl ? 26px : 22px;
        RtokTheme.body-size = root.width >= RtokTheme.bp-xl ? 14px : 13px;
    }
    changed height => { win-h = root.height; }
    init => {
        win-w = root.width;
        win-h = root.height;
        RtokTheme.title-size = root.width >= RtokTheme.bp-xl ? 26px : 22px;
        RtokTheme.body-size = root.width >= RtokTheme.bp-xl ? 14px : 13px;
        // Native std-widgets (LineEdit, scrollbars) follow the app theme,
        // not the OS (declarative `Global.prop:` bindings are not accepted).
        Palette.color-scheme = RtokTheme.dark ? ColorScheme.dark : ColorScheme.light;
    }

    property <bool> compact: win-w < RtokTheme.bp-sm;
    property <bool> rail: win-w >= RtokTheme.bp-sm && win-w < RtokTheme.bp-md;
    property <bool> full-nav: win-w >= RtokTheme.bp-md;
    property <bool> wide: win-w >= RtokTheme.bp-lg;
    property <bool> ultrawide: win-w >= RtokTheme.bp-xl;

    property <length> shell-pad: ultrawide ? RtokTheme.space-5 : (wide ? RtokTheme.space-4 : (compact ? RtokTheme.space-2 : RtokTheme.space-3));
    property <length> shell-gap: ultrawide ? RtokTheme.space-4 : RtokTheme.space-3;
    property <length> nav-width: rail ? RtokTheme.sidebar-w-rail : RtokTheme.sidebar-w-full;
    property <length> plugin-list-w: wide ? min(280px, win-w * 0.22) : min(240px, win-w * 0.28);
    property <length> calls-list-w: min(480px, win-w * 0.42);
    property <length> content-max: ultrawide ? 1600px : 10000px;

    VerticalBox {
        padding: shell-pad;
        spacing: shell-gap;
        alignment: stretch;

        if error != "": Card {
            border-radius: RtokTheme.radius-md;
            background: RtokTheme.surface-2;
            border-color: RtokTheme.delta;
            min-height: 32px;
            preferred-height: 32px;
            max-height: 32px;
            Text {
                text: error;
                color: RtokTheme.delta;
                font-size: 12px;
                x: RtokTheme.space-3;
                y: parent.height / 2 - self.height / 2;
            }
        }

        // Mobile: horizontal icon bar (icons only, equal buttons, ≥36px hits)
        if compact: Card {
            min-height: 52px;
            preferred-height: 52px;
            max-height: 52px;
            HorizontalBox {
                padding: RtokTheme.space-1;
                spacing: 2px;
                alignment: stretch;
                for p[i] in pages: NavItem {
                    page-id: p.id;
                    title: p.title;
                    selected: i == page-index;
                    show-label: false;
                    icon-only: true;
                    activated => { page-index = i; }
                }
                NavItem {
                    page-id: "theme";
                    title: "theme";
                    show-label: false;
                    icon-only: true;
                    activated => { root.dark = !root.dark; root.theme-toggle(); }
                }
            }
        }

        HorizontalBox {
            spacing: shell-gap;
            alignment: stretch;

            // Tablet rail / desktop full sidebar
            if !compact: Card {
                width: nav-width;
                VerticalBox {
                    padding: RtokTheme.space-2;
                    spacing: RtokTheme.space-2;

                    HorizontalBox {
                        spacing: RtokTheme.space-2;
                        alignment: full-nav ? start : center;
                        Image {
                            source: @image-url("assets/logo.svg");
                            min-width: 24px;
                            min-height: 24px;
                            preferred-width: 24px;
                            preferred-height: 24px;
                            max-width: 24px;
                            max-height: 24px;
                        }
                        if full-nav: SectionText {
                            text: "RTOK";
                            font-weight: 700;
                            vertical-alignment: center;
                        }
                    }

                    if full-nav: Rectangle {
                        min-height: 28px;
                        preferred-height: 28px;
                        max-height: 28px;
                        border-radius: RtokTheme.radius-md;
                        background: RtokTheme.surface-2;
                        HorizontalBox {
                            padding-left: RtokTheme.space-2;
                            spacing: RtokTheme.space-2;
                            alignment: start;
                            Rectangle {
                                width: 8px;
                                height: 8px;
                                border-radius: 4px;
                                background: RtokTheme.accent;
                                y: parent.height / 2 - self.height / 2;
                            }
                            MetaText {
                                text: status;
                                vertical-alignment: center;
                            }
                        }
                    }

                    ListView {
                        for p[i] in pages: NavItem {
                            page-id: p.id;
                            title: p.title;
                            selected: i == page-index;
                            show-label: full-nav;
                            icon-only: rail;
                            activated => { page-index = i; }
                        }
                    }

                    NavItem {
                        page-id: "theme";
                        title: RtokTheme.dark ? "Light mode" : "Dark mode";
                        show-label: full-nav;
                        icon-only: rail;
                        activated => { root.dark = !root.dark; root.theme-toggle(); }
                    }
                }
            }

            // Content pane — stretch; cap readable width on ultrawide via max on metric strips / prose
            Rectangle {
                horizontal-stretch: 1;
                background: transparent;

                if page-id == "overview": ScrollView {
                    VerticalBox {
                        padding: wide ? RtokTheme.space-2 : 0;
                        spacing: shell-gap;
                        alignment: start;
                        max-width: content-max;
                        TitleText {
                            text: "overview";
                        }
                        MetaText {
                            text: "usage totals (usage rows, all apis)";
                        }
                        TokenStatsWidget {
                            input-tokens: usage-input;
                            output-tokens: usage-output;
                            cache-read: usage-cache-read;
                            cache-create: usage-cache-create;
                            est-before: 0;
                            est-after: 0;
                            rows: 0;
                        }
                        BodyText {
                            text: "ctt  \{usage-ctt} (input-side tok × turns after)";
                            color: RtokTheme.ink;
                        }
                        MetaText {
                            text: "saved by plugin (Measurement rows)";
                        }
                        BodyText {
                            text: overview-savings;
                        }
                        BodyText {
                            text: overview-turns;
                            color: RtokTheme.ink-subtle;
                        }
                    }
                }

                // Plugins: stacked on compact, side-by-side otherwise
                if page-id == "plugins" && compact: VerticalBox {
                    spacing: shell-gap;
                    Card {
                        min-height: 120px;
                        preferred-height: min(200px, win-h * 0.35);
                        max-height: min(200px, win-h * 0.35);
                        VerticalBox {
                            padding: RtokTheme.space-2;
                            SectionText {
                                text: "plugins";
                            }
                            ListView {
                                for p[i] in plugins: ListRow {
                                    selected: i == plugin-cursor;
                                    label: p.title;
                                    row-height: 36px;
                                    activated => { plugin-cursor = i; }
                                    HorizontalBox {
                                        padding-left: RtokTheme.space-2;
                                        alignment: start;
                                        Text {
                                            text: p.title;
                                            color: i == plugin-cursor ? RtokTheme.accent : (p.enabled ? RtokTheme.ink : RtokTheme.ink-subtle);
                                            vertical-alignment: center;
                                        }
                                    }
                                }
                            }
                        }
                    }
                    ScrollView {
                        vertical-stretch: 1;
                        VerticalBox {
                            spacing: shell-gap;
                            alignment: start;
                            TitleText {
                                text: selected-plugin.title;
                            }
                            PluginEnableToggle {
                                on: selected-plugin.enabled;
                                plugin-id: selected-plugin.id;
                                enable(value) => {
                                    root.toggle-plugin(selected-plugin.id, value);
                                }
                            }
                            BodyText {
                                text: selected-plugin.summary;
                            }
                            BodyText {
                                text: selected-plugin.fields;
                                color: RtokTheme.ink-subtle;
                            }
                            if selected-plugin.saves-tokens: TokenStatsWidget {
                                input-tokens: selected-plugin.input-tokens;
                                output-tokens: selected-plugin.output-tokens;
                                cache-read: selected-plugin.cache-read;
                                cache-create: selected-plugin.cache-create;
                                est-before: selected-plugin.est-before;
                                est-after: selected-plugin.est-after;
                                rows: selected-plugin.rows;
                            }
                        }
                    }
                }

                if page-id == "plugins" && !compact: HorizontalBox {
                    spacing: shell-gap;
                    Card {
                        width: plugin-list-w;
                        VerticalBox {
                            padding: RtokTheme.space-2;
                            SectionText {
                                text: "plugins";
                            }
                            ListView {
                                for p[i] in plugins: ListRow {
                                    selected: i == plugin-cursor;
                                    label: p.title;
                                    row-height: 36px;
                                    activated => { plugin-cursor = i; }
                                    HorizontalBox {
                                        padding-left: RtokTheme.space-2;
                                        alignment: start;
                                        Text {
                                            text: p.title;
                                            color: i == plugin-cursor ? RtokTheme.accent : (p.enabled ? RtokTheme.ink : RtokTheme.ink-subtle);
                                            vertical-alignment: center;
                                        }
                                    }
                                }
                            }
                        }
                    }
                    ScrollView {
                        horizontal-stretch: 1;
                        VerticalBox {
                            spacing: shell-gap;
                            alignment: start;
                            max-width: content-max;
                            TitleText {
                                text: selected-plugin.title;
                            }
                            PluginEnableToggle {
                                on: selected-plugin.enabled;
                                plugin-id: selected-plugin.id;
                                enable(value) => {
                                    root.toggle-plugin(selected-plugin.id, value);
                                }
                            }
                            BodyText {
                                text: selected-plugin.summary;
                            }
                            BodyText {
                                text: selected-plugin.fields;
                                color: RtokTheme.ink-subtle;
                            }
                            if selected-plugin.saves-tokens: TokenStatsWidget {
                                input-tokens: selected-plugin.input-tokens;
                                output-tokens: selected-plugin.output-tokens;
                                cache-read: selected-plugin.cache-read;
                                cache-create: selected-plugin.cache-create;
                                est-before: selected-plugin.est-before;
                                est-after: selected-plugin.est-after;
                                rows: selected-plugin.rows;
                            }
                        }
                    }
                }

                // Calls: stacked on compact, side-by-side otherwise
                if page-id == "calls" && compact: VerticalBox {
                    spacing: shell-gap;
                    Card {
                        min-height: 120px;
                        preferred-height: min(220px, win-h * 0.4);
                        max-height: min(220px, win-h * 0.4);
                        VerticalBox {
                            padding: RtokTheme.space-2;
                            SectionText {
                                text: "calls (newest first)";
                            }
                            if calls.length == 0: BodyText {
                                text: "no calls yet (the ledger fills as hooks, MCP and the proxy run)";
                            }
                            ListView {
                                for c[i] in calls: ListRow {
                                    selected: i == call-cursor;
                                    label: c.name;
                                    row-height: 40px;
                                    activated => { call-cursor = i; }
                                    VerticalBox {
                                        padding-left: RtokTheme.space-2;
                                        spacing: 0;
                                        Text {
                                            text: "\{c.when}  \{c.surface}  \{c.kind}";
                                            color: i == call-cursor ? RtokTheme.accent : RtokTheme.ink;
                                            font-size: 12px;
                                        }
                                        MetaText {
                                            text: c.subtitle;
                                        }
                                    }
                                }
                            }
                        }
                    }
                    ScrollView {
                        vertical-stretch: 1;
                        VerticalBox {
                            spacing: RtokTheme.space-2;
                            alignment: start;
                            MetaText {
                                text: "detail";
                            }
                            if calls.length == 0: Text { text: ""; }
                            if calls.length > 0: VerticalBox {
                                BodyText {
                                    text: selected-call.detail;
                                }
                                CallArchive {
                                    ref-id: selected-call.ref-id;
                                    view <=> root.expand-view;
                                    filter <=> root.expand-filter;
                                    expand-archive(id) => { root.expand-archive(id); }
                                    filter-expand(s) => { root.filter-expand(s); }
                                }
                            }
                        }
                    }
                }

                if page-id == "calls" && !compact: HorizontalBox {
                    spacing: shell-gap;
                    Card {
                        width: calls-list-w;
                        VerticalBox {
                            padding: RtokTheme.space-2;
                            SectionText {
                                text: "calls (newest first)";
                            }
                            if calls.length == 0: BodyText {
                                text: "no calls yet (the ledger fills as hooks, MCP and the proxy run)";
                            }
                            ListView {
                                for c[i] in calls: ListRow {
                                    selected: i == call-cursor;
                                    label: c.name;
                                    row-height: 40px;
                                    activated => { call-cursor = i; }
                                    VerticalBox {
                                        padding-left: RtokTheme.space-2;
                                        spacing: 0;
                                        Text {
                                            text: "\{c.when}  \{c.surface}  \{c.kind}";
                                            color: i == call-cursor ? RtokTheme.accent : RtokTheme.ink;
                                            font-size: 12px;
                                        }
                                        MetaText {
                                            text: c.subtitle;
                                        }
                                    }
                                }
                            }
                        }
                    }
                    ScrollView {
                        horizontal-stretch: 1;
                        VerticalBox {
                            spacing: RtokTheme.space-2;
                            alignment: start;
                            max-width: content-max;
                            MetaText {
                                text: "detail";
                            }
                            if calls.length == 0: Text { text: ""; }
                            if calls.length > 0: VerticalBox {
                                BodyText {
                                    text: selected-call.detail;
                                }
                                CallArchive {
                                    ref-id: selected-call.ref-id;
                                    view <=> root.expand-view;
                                    filter <=> root.expand-filter;
                                    expand-archive(id) => { root.expand-archive(id); }
                                    filter-expand(s) => { root.filter-expand(s); }
                                }
                            }
                        }
                    }
                }

                if page-id == "sessions": HorizontalBox {
                    spacing: shell-gap;
                    Card {
                        width: calls-list-w;
                        VerticalBox {
                            padding: RtokTheme.space-2;
                            TitleText {
                                text: "sessions";
                            }
                            if sessions.length == 0: BodyText {
                                text: "no sessions yet";
                            }
                            ListView {
                                for s[i] in sessions: ListRow {
                                    selected: i == session-cursor;
                                    label: "session " + s.id;
                                    row-height: 56px;
                                    activated => { session-cursor = i; }
                                    VerticalBox {
                                        padding-left: RtokTheme.space-2;
                                        spacing: 0;
                                        Text {
                                            text: s.summary;
                                            color: i == session-cursor ? RtokTheme.accent : RtokTheme.ink;
                                            font-weight: 600;
                                            font-size: RtokTheme.body-size;
                                        }
                                        MetaText {
                                            text: s.activity;
                                        }
                                    }
                                }
                            }
                        }
                    }
                    ScrollView {
                        horizontal-stretch: 1;
                        VerticalBox {
                            spacing: RtokTheme.space-2;
                            alignment: start;
                            max-width: content-max;
                            MetaText {
                                text: "detail";
                            }
                            if sessions.length == 0: Text { text: ""; }
                            if sessions.length > 0: BodyText {
                                text: selected-session.detail;
                            }
                        }
                    }
                }

                if page-id == "doctor": ScrollView {
                    VerticalBox {
                        spacing: RtokTheme.space-2;
                        alignment: start;
                        max-width: content-max;
                        TitleText {
                            text: "doctor";
                        }
                        BodyText {
                            text: doctor-text;
                        }
                    }
                }

                if page-id == "logs": ScrollView {
                    VerticalBox {
                        spacing: RtokTheme.space-1;
                        alignment: start;
                        max-width: content-max;
                        TitleText {
                            text: "logs";
                        }
                        if logs.length == 0: BodyText {
                            text: "no logs yet";
                        }
                        for line in logs: Text {
                            text: line;
                            color: RtokTheme.ink-muted;
                            wrap: word-wrap;
                            font-size: ultrawide ? 13px : 12px;
                        }
                    }
                }

                if page-id == "skills": ScrollView {
                    VerticalBox {
                        spacing: RtokTheme.space-2;
                        alignment: start;
                        max-width: content-max;
                        TitleText {
                            text: "skills";
                        }
                        BodyText {
                            text: skills-header;
                        }
                        CheckBox {
                            accessible-label: "never invoked only";
                            text: "never invoked only";
                            checked: skills-never-only;
                            toggled() => { skills-never-only = self.checked; }
                        }
                        if skills.length == 0: BodyText {
                            text: "no skills listed";
                        }
                        for s in skills: Rectangle {
                            property <bool> shown: !skills-never-only || s.never;
                            height: shown ? 48px : 0px;
                            if shown: ListRow {
                                label: "skill " + s.name;
                                row-height: 48px;
                                Text {
                                    text: s.summary;
                                    x: 0;
                                    color: s.never ? RtokTheme.ink-muted : RtokTheme.ink;
                                    font-size: RtokTheme.body-size;
                                }
                            }
                        }
                    }
                }
            }
        }
    }
}
