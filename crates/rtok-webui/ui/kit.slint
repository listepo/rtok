// rtok web UI kit — the one place a look lives. Screens compose these
// components; nothing here knows the app's pages, models or callbacks.
// Every color/space/size comes from `theme.slint` tokens, never literals.

import { HorizontalBox } from "std-widgets.slint";

import { RtokTheme } from "theme.slint";

/// Page heading — mono bold ink at the theme's title size.
export component TitleText inherits Text {
    color: RtokTheme.ink;
    font-family: "IBM Plex Mono";
    font-size: RtokTheme.title-size;
    font-weight: 700;
}

/// Panel heading — mono ink at the fixed 16px step.
export component SectionText inherits Text {
    color: RtokTheme.ink;
    font-family: "IBM Plex Mono";
    font-size: 16px;
    font-weight: 600;
}

/// Small muted mono label — column captions, section notes, empty states.
export component MetaText inherits Text {
    color: RtokTheme.ink-muted;
    font-family: "IBM Plex Mono";
    font-size: 11px;
}

/// Body copy — muted mono that wraps at the panel edge.
export component BodyText inherits Text {
    color: RtokTheme.ink-muted;
    font-family: "IBM Plex Mono";
    font-size: RtokTheme.body-size;
    wrap: word-wrap;
}

/// The standard surface panel (sidebars, list cards, bars).
export component Card inherits Rectangle {
    border-radius: RtokTheme.radius-lg;
    background: RtokTheme.surface-1;
    border-width: 1px;
    border-color: RtokTheme.hairline;
}

/// Page/nav icon: one 16px monochrome glyph, tinted to the theme. The
/// min/preferred/max constraints pin the size — layouts would otherwise
/// stretch the SVG's intrinsic 24px over its nav button.
export component PageIcon inherits Image {
    in property <string> page-id;
    in property <color> tint: RtokTheme.ink-muted;
    min-width: 16px;
    min-height: 16px;
    preferred-width: 16px;
    preferred-height: 16px;
    max-width: 16px;
    max-height: 16px;
    colorize: tint;
    source:
        page-id == "overview" ? @image-url("icons/overview.svg") :
        page-id == "plugins" ? @image-url("icons/plugins.svg") :
        page-id == "calls" ? @image-url("icons/calls.svg") :
        page-id == "sessions" ? @image-url("icons/sessions.svg") :
        page-id == "doctor" ? @image-url("icons/doctor.svg") :
        page-id == "logs" ? @image-url("icons/logs.svg") :
        page-id == "skills" ? @image-url("icons/doctor.svg") :
        page-id == "theme" ? @image-url("icons/theme.svg") :
        @image-url("icons/overview.svg");
}

/// Nav row: icon ± label, selection and hover feedback. Icon-only instances
/// (`show-label: false`) are the tool buttons of the mobile bar.
export component NavItem inherits Rectangle {
    in property <string> page-id;
    in property <string> title;
    in property <bool> selected;
    in property <bool> show-label: true;
    in property <bool> icon-only: false;
    callback activated;
    min-height: icon-only ? 44px : 36px;
    preferred-height: icon-only ? 44px : 36px;
    max-height: icon-only ? 44px : 36px;
    // In the icon bar every button shares the row width equally; in the
    // sidebar the ListView owns the row width.
    horizontal-stretch: icon-only ? 1 : 0;
    min-width: icon-only ? 36px : 0px;
    border-radius: RtokTheme.radius-md;
    background: selected
        ? RtokTheme.accent-muted
        : (nav-ta.has-hover ? RtokTheme.surface-2 : transparent);
    animate background { duration: 150ms; }
    nav-ta := TouchArea {
        accessible-role: button;
        accessible-label: root.title;
        mouse-cursor: pointer;
        clicked => { root.activated(); }
    }
    HorizontalBox {
        padding-left: show-label ? RtokTheme.space-2 : 0;
        spacing: RtokTheme.space-2;
        alignment: show-label ? start : center;
        PageIcon {
            page-id: root.page-id;
            tint: selected ? RtokTheme.accent : RtokTheme.ink-muted;
        }
        if show-label: Text {
            text: title;
            color: selected ? RtokTheme.accent : RtokTheme.ink-muted;
            font-family: "IBM Plex Mono";
            vertical-alignment: center;
        }
    }
}

/// Selectable list row — highlight, hover, cursor and the accessible label
/// live here once; the children are whatever the list row shows.
export component ListRow inherits Rectangle {
    in property <bool> selected;
    in property <string> label;
    in property <length> row-height: 36px;
    callback activated;
    height: row-height;
    min-height: row-height;
    max-height: row-height;
    border-radius: RtokTheme.radius-md;
    background: selected
        ? RtokTheme.accent-muted
        : (row-ta.has-hover ? RtokTheme.surface-2 : transparent);
    animate background { duration: 150ms; }
    row-ta := TouchArea {
        accessible-role: button;
        accessible-label: root.label;
        mouse-cursor: pointer;
        clicked => { root.activated(); }
    }
    @children
}
