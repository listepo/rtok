root = true

# Line endings are also pinned for git in .gitattributes (T82); keep the two in step.
[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.{md,yml,yaml,toml,json,ts,js,sh,html,css,gotmpl}]
indent_size = 2

# Byte-exact test fixtures: trailing spaces and a missing final newline are part of the
# expected output (trycmd stdout, cmd goldens, proxy request bodies, insta snapshots).
# An editor must save them exactly as they are.
[{tests/trycmd/**,tests/cmd_golden/**,tests/fixtures/**,**/snapshots/**}]
trim_trailing_whitespace = false
insert_final_newline = unset
indent_style = unset
indent_size = unset

# Vendored upstream files and exported assets are kept as shipped (OFL.txt is CRLF).
[{crates/rtok-webui/ui/fonts/**,**/*.svg}]
end_of_line = unset
trim_trailing_whitespace = unset
insert_final_newline = unset
indent_style = unset
indent_size = unset
