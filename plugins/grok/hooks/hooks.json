{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [{ "type": "command", "command": "rtok hook PreToolUse --host grok", "timeout": 5 }]
      }
    ],
    "PostToolUse": [
      {
        "hooks": [{ "type": "command", "command": "rtok hook PostToolUse --host grok", "timeout": 5 }]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [{ "type": "command", "command": "rtok hook UserPromptSubmit --host grok", "timeout": 5 }]
      }
    ],
    "SessionStart": [
      {
        "hooks": [{ "type": "command", "command": "rtok hook SessionStart --host grok", "timeout": 5 }]
      }
    ],
    "PreCompact": [
      {
        "hooks": [{ "type": "command", "command": "rtok hook PreCompact --host grok", "timeout": 5 }]
      }
    ],
    "PostCompact": [
      {
        "hooks": [{ "type": "command", "command": "rtok hook PostCompact --host grok", "timeout": 5 }]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [{ "type": "command", "command": "rtok hook SessionEnd --host grok", "timeout": 5 }]
      }
    ]
  }
}
