#!/bin/sh
# rtok hook launcher for Cline file hooks (T95; D21 fail-open with the ketch hint).
#
# Cline runs one executable per event: the file name IS the event, so T96 links
# this script once per event (`PreToolUse`, `PostToolUse`, ...) into the hooks
# directory and Cline invokes it as `<Event>` with the file-hook JSON on stdin.
# The event is the basename of $0 with any extension stripped
# (`PreToolUse`, `PreToolUse.sh` and `PreToolUse.exe` all mean `PreToolUse`).
#
# The desktop extension may start without a shell PATH, so the binary is
# resolved by hand after PATH (T174/T250: same order and fail-open shape as
# `plugins/claude/scripts/hook.sh` and `plugins/zcode/scripts/hook.sh`).
set -u
base=${0##*/}
event=${base%.*}
case $event in
  *\"* | *\'* | *\ * | *\;* | *\&* | *\|* | *\`* | *\$* | *\(* | *\)* | *\<* | *\>*)
    printf '%s\n' '{}'
    exit 0
    ;;
esac
for bin in "$(command -v rtok 2>/dev/null)" "$HOME/.ketch/bin/rtok" \
  /usr/local/bin/rtok /opt/homebrew/bin/rtok; do
  if [ -n "$bin" ] && [ -x "$bin" ]; then
    exec "$bin" hook "$event" --host cline
  fi
done
# T174: rtok is missing everywhere we look. Stay silent on every other event — a
# stderr blob on every tool call was 380 "command not found"-shaped hook errors/week
# in the field — and name the install command exactly once, on TaskStart (Cline's
# session start), in Cline's own hook shape (`context` is injected into the turn).
if [ "$event" = "TaskStart" ]; then
  printf '%s' '{"context":"rtok is not installed; run ketch install listepo/rtok to enable it."}'
  exit 0
fi
printf '%s\n' '{}'
exit 0
