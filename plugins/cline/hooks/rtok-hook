#!/bin/sh
# rtok hook launcher for Cline file hooks (T95; D21 fail-open with the ketch hint).
#
# Cline runs one executable per event: the file name IS the event, so T96 links
# this script once per event (`PreToolUse`, `PostToolUse`, ...) into the hooks
# directory and Cline invokes it as `<Event>` with the file-hook JSON on stdin.
# The event is the basename of $0 with any extension stripped
# (`PreToolUse`, `PreToolUse.sh` and `PreToolUse.exe` all mean `PreToolUse`).
#
# The desktop extension may start without a shell PATH, so the binary is
# resolved by hand before falling back to PATH.
set -u
base=${0##*/}
event=${base%.*}
case $event in
  *\"* | *\'* | *\ * | *\;* | *\&* | *\|* | *\`* | *\$* | *\(* | *\)* | *\<* | *\>*)
    printf '%s\n' '{}'
    exit 0
    ;;
esac
for bin in "$HOME/.ketch/bin/rtok" /usr/local/bin/rtok /opt/homebrew/bin/rtok; do
  if [ -n "$bin" ] && [ -x "$bin" ]; then
    exec "$bin" hook "$event" --host cline
  fi
done
if command -v rtok >/dev/null 2>&1; then
  exec rtok hook "$event" --host cline
fi
cat >&2 <<'EOF'
rtok is not installed; this hook passes the input through unchanged.

Install with ketch:
  ketch install listepo/rtok

If ketch is not installed:
  curl -fsSL https://raw.githubusercontent.com/listepo/ketch/main/install.sh | bash
  ketch install listepo/rtok
EOF
printf '%s\n' '{}'
exit 0
