#!/usr/bin/env node
"use strict";
// Runs the native rtok binary from the platform package that matches this host. On Unix the
// postinstall step (install.js) replaces this file with that binary, so `rtok` on PATH starts
// without Node; this launcher is what remains on Windows or when install scripts are disabled.

const { spawnSync } = require("node:child_process");
const { nativeBinary } = require("../lib/platform.js");

let binary;
try {
  binary = nativeBinary();
} catch (error) {
  process.stderr.write(`rtok: ${error.message}\n`);
  process.exit(1);
}

const result = spawnSync(binary, process.argv.slice(2), { stdio: "inherit" });
if (result.error) {
  process.stderr.write(`rtok: cannot run ${binary}: ${result.error.message}\n`);
  process.exit(1);
}
if (result.signal) {
  process.kill(process.pid, result.signal);
}
process.exit(result.status ?? 1);
