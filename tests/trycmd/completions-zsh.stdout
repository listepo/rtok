#compdef rtok

autoload -U is-at-least

_rtok() {
    typeset -A opt_args
    typeset -a _arguments_options
    local ret=1

    if is-at-least 5.2; then
        _arguments_options=(-s -S -C)
    else
        _arguments_options=(-s -C)
    fi

    local context curcontext="$curcontext" state line
    _arguments "${_arguments_options[@]}" : /
'--config=[User config file (else /`RTOK_CONFIG/` or /`<home>/config.toml/`)]:PATH:_files' /
'-h[Print help]' /
'--help[Print help]' /
'-V[Print version]' /
'--version[Print version]' /
":: :_rtok_commands" /
"*::: :->rtok" /
&& ret=0
    case $state in
    (rtok)
        words=($line[1] "${words[@]}")
        (( CURRENT += 1 ))
        curcontext="${curcontext%:*:*}:rtok-command-$line[1]:"
        case $line[1] in
            (hook)
_arguments "${_arguments_options[@]}" : /
'--host=[Overlay /`/[hook/] host/` (/`claude/` | /`cursor/` | /`copilot/`)]:HOST:_default' /
'--config=[User config file (else /`RTOK_CONFIG/` or /`<home>/config.toml/`)]:PATH:_files' /
'-h[Print help]' /
'--help[Print help]' /
':event:_default' /
&& ret=0
;;
(mcp)
_arguments "${_arguments_options[@]}" : /
'--config=[User config file (else /`RTOK_CONFIG/` or /`<home>/config.toml/`)]:PATH:_files' /
'-h[Print help]' /
'--help[Print help]' /
'*::wrap -- Foreign stdio MCP server to wrap losslessly (`rtok mcp -- npx some-server`):_default' /
&& ret=0
;;
(proxy)
_arguments "${_arguments_options[@]}" : /
'--port=[Override /`/[proxy/] port/`]:PORT:_default' /
'--upstream=[Override /`/[proxy/] upstream/`]:UPSTREAM:_default' /
'--mode=[Override /`/[proxy/] mode/` (/`passthrough/` | /`compress/`)]:MODE:_default' /
'--config=[User config file (else /`RTOK_CONFIG/` or /`<home>/config.toml/`)]:PATH:_files' /
'--dry-run[Print effective /`/[proxy/]/` settings and exit]' /
'-h[Print help]' /
'--help[Print help]' /
&& ret=0
;;
(web)
_arguments "${_arguments_options[@]}" : /
'--host=[Override /`/[web/] host/`]:HOST:_default' /
'--port=[Override /`/[web/] port/`]:PORT:_default' /
'--config=[User config file (else /`RTOK_CONFIG/` or /`<home>/config.toml/`)]:PATH:_files' /
'-h[Print help]' /
'--help[Print help]' /
&& ret=0
;;
(tui)
_arguments "${_arguments_options[@]}" : /
'--tab=[Start on this tab (a page name both surfaces carry)]:TAB:_default' /
'--tick-secs=[Model re-read cadence in seconds]:TICK_SECS:_default' /
'--config=[User config file (else /`RTOK_CONFIG/` or /`<home>/config.toml/`)]:PATH:_files' /
'-h[Print help]' /
'--help[Print help]' /
&& ret=0
;;
(stats)
_arguments "${_arguments_options[@]}" : /
'--since=[How far back to read transcripts (/`60d/`, /`24h/`)]:SINCE:_default' /
'--plugin=[Restrict to one tool or plugin id]:PLUGIN:_default' /
'--save-baseline=[Write this report JSON to /`<home>/measurements/<name>.json/`]:NAME:_default' /
'--compare=[Print deltas against a saved baseline]:NAME:_default' /
'--config=[User config file (else /`RTOK_CONFIG/` or /`<home>/config.toml/`)]:PATH:_files' /
'--json[JSON instead of the table]' /
'--calibrate[Fit chars-per-token via count_tokens (skipped without an API key)]' /
'--cache[Cache health per session from proxy usage rows/: busts and their cause]' /
'--price[Show per-model USD costs from /`/[stats.prices/]/` (/`--price/`)]' /
'-h[Print help]' /
'--help[Print help]' /
&& ret=0
;;
(bench)
_arguments "${_arguments_options[@]}" : /
'--tasks=[Task list TOML]:TASKS:_files' /
'--runs=[Repeats per task × config]:RUNS:_default' /
'--timeout=[Per-run timeout in seconds]:TIMEOUT:_default' /
'--config=[User config file (else /`RTOK_CONFIG/` or /`<home>/config.toml/`)]:PATH:_files' /
'--dry-run[Print the schedule and exit]' /
'-h[Print help]' /
'--help[Print help]' /
&& ret=0
;;
(doctor)
_arguments "${_arguments_options[@]}" : /
'--config=[User config file (else /`RTOK_CONFIG/` or /`<home>/config.toml/`)]:PATH:_files' /
'--instructions[Also run the instruction-file audit (T7.2)]' /
'--json[JSON instead of the table]' /
'-h[Print help]' /
'--help[Print help]' /
&& ret=0
;;
(info)
_arguments "${_arguments_options[@]}" : /
'--config=[User config file (else /`RTOK_CONFIG/` or /`<home>/config.toml/`)]:PATH:_files' /
'--json[JSON instead of the text lines]' /
'-h[Print help]' /
'--help[Print help]' /
&& ret=0
;;
(agents)
_arguments "${_arguments_options[@]}" : /
'--config=[User config file (else /`RTOK_CONFIG/` or /`<home>/config.toml/`)]:PATH:_files' /
'-h[Print help]' /
'--help[Print help]' /
":: :_rtok__subcmd__agents_commands" /
"*::: :->agents" /
&& ret=0

    case $state in
    (agents)
        words=($line[1] "${words[@]}")
        (( CURRENT += 1 ))
        curcontext="${curcontext%:*:*}:rtok-agents-command-$line[1]:"
        case $line[1] in
            (install)
_arguments "${_arguments_options[@]}" : /
'*--mode=[Enable prompt modes (/`terse,yagni/`)]:MODE:_default' /
'--config=[User config file (else /`RTOK_CONFIG/` or /`<home>/config.toml/`)]:PATH:_files' /
'--dry-run[Print the planned edits and exit]' /
'--remove[Remove rtok from the host (hooks, MCP, proxy, plugin link); prefer /`rtok agents remove <host>/`]' /
'--yes[Confirm destructive /`--replace/`]' /
'--replace[Remove legacy token hooks and retarget the proxy]' /
'--mcp[Register /`rtok mcp/` in the host MCP map]' /
'--proxy[Set /`env.ANTHROPIC_BASE_URL/` to this proxy]' /
'--cli[Only the CLI app (/`cursor/`//`opencode/` have CLI and desktop; default is all)]' /
'--desktop[Only the desktop app (/`cursor/`//`opencode/` have CLI and desktop; default is all)]' /
'--all[All variants (the default when neither /`--cli/` nor /`--desktop/` is given)]' /
'-h[Print help]' /
'--help[Print help]' /
':host -- Host(s), comma-separated (`claude`, `cursor`, `codex`, `opencode`, `pi`, `zcode`, `kimi`, `copilot`, `aider`, `windsurf`, `zed`):_default' /
&& ret=0
;;
(remove)
_arguments "${_arguments_options[@]}" : /
'--config=[User config file (else /`RTOK_CONFIG/` or /`<home>/config.toml/`)]:PATH:_files' /
'--dry-run[Print what would be removed and exit]' /
'-h[Print help]' /
'--help[Print help]' /
':host -- Host(s), comma-separated (`claude`, `cursor`, `codex`, `opencode`, `pi`, `zcode`, `kimi`, `copilot`, `aider`, `windsurf`, `zed`):_default' /
&& ret=0
;;
(list)
_arguments "${_arguments_options[@]}" : /
'--config=[User config file (else /`RTOK_CONFIG/` or /`<home>/config.toml/`)]:PATH:_files' /
'--json[JSON instead of the table]' /
'-h[Print help]' /
'--help[Print help]' /
&& ret=0
;;
(sessions)
_arguments "${_arguments_options[@]}" : /
'--config=[User config file (else /`RTOK_CONFIG/` or /`<home>/config.toml/`)]:PATH:_files' /
'--all[Also show sessions that have ended]' /
'--json[JSON instead of the table]' /
'-h[Print help]' /
'--help[Print help]' /
":: :_rtok__subcmd__agents__subcmd__sessions_commands" /
"*::: :->sessions" /
&& ret=0

    case $state in
    (sessions)
        words=($line[1] "${words[@]}")
        (( CURRENT += 1 ))
        curcontext="${curcontext%:*:*}:rtok-agents-sessions-command-$line[1]:"
        case $line[1] in
            (watch)
_arguments "${_arguments_options[@]}" : /
'--config=[User config file (else /`RTOK_CONFIG/` or /`<home>/config.toml/`)]:PATH:_files' /
'--all[Also show sessions that have ended]' /
'-h[Print help]' /
'--help[Print help]' /
&& ret=0
;;
(help)
_arguments "${_arguments_options[@]}" : /
":: :_rtok__subcmd__agents__subcmd__sessions__subcmd__help_commands" /
"*::: :->help" /
&& ret=0

    case $state in
    (help)
        words=($line[1] "${words[@]}")
        (( CURRENT += 1 ))
        curcontext="${curcontext%:*:*}:rtok-agents-sessions-help-command-$line[1]:"
        case $line[1] in
            (watch)
_arguments "${_arguments_options[@]}" : /
&& ret=0
;;
(help)
_arguments "${_arguments_options[@]}" : /
&& ret=0
;;
        esac
    ;;
esac
;;
        esac
    ;;
esac
;;
(help)
_arguments "${_arguments_options[@]}" : /
":: :_rtok__subcmd__agents__subcmd__help_commands" /
"*::: :->help" /
&& ret=0

    case $state in
    (help)
        words=($line[1] "${words[@]}")
        (( CURRENT += 1 ))
        curcontext="${curcontext%:*:*}:rtok-agents-help-command-$line[1]:"
